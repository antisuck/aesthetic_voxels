    Name =
        "Reset Size",

    Callback = function()

        applyCrosshairSize(
            32
        )

        Rayfield:Notify({

            Title =
                "Crosshair",

            Content =
                "Size reset to 32 px.",

            Duration = 2
        })
    end
})

TabCrosshair:CreateDivider()

TabCrosshair:CreateInput({

    Name =
        "Cursor Name",

    PlaceholderText =
        "Minecraft",

    RemoveTextAfterFocusLost =
        false,

    Callback = function(text)

        CrosshairState.CursorName =
            text
    end
})

TabCrosshair:CreateButton({

    Name =
        "Save Cursor",

    Callback = function()

        local name =
            CrosshairState.CursorName:
            match(
                "^%s*(.-)%s*$"
            )

        local id =
            CrosshairState.ImageID:
            match(
                "^%s*(.-)%s*$"
            )

        if name == "" then

            Rayfield:Notify({

                Title =
                    "Crosshair",

                Content =
                    "Enter cursor name.",

                Duration = 3
            })

            return
        end

        if id == "" then

            Rayfield:Notify({

                Title =
                    "Crosshair",

                Content =
                    "Enter Asset ID.",

                Duration = 3
            })

            return
        end

        CrosshairState.SavedCursors[name] = {

            id =
                id,

            size =
                CrosshairState.Size,

            enabled =
                CrosshairState.Enabled
        }

        local success =
            saveCursors()

        if not success then

            Rayfield:Notify({

                Title =
                    "Crosshair",

                Content =
                    "File system unavailable.",

                Duration = 3
            })

            return
        end

        Rayfield:Notify({

            Title =
                "Cursor Saved",

            Content =
                name,

            Duration = 2
        })
    end
})

local SelectedCursor
local CursorDropdown

CursorDropdown =
    TabCrosshair:CreateDropdown({

        Name =
            "Saved Cursors",

        Options =
            getCursorNames(),

        CurrentOption = {},

        MultipleOptions =
            false,

        Callback = function(options)

            local name =
                options
                and options[1]

            if not name then
                return
            end

            SelectedCursor =
                name

            local data =
                CrosshairState
                .SavedCursors[name]

            if not data then
                return
            end

            CrosshairState.ImageID =
                tostring(
                    data.id or ""
                )

            CrosshairState.Size =
                tonumber(
                    data.size
                ) or 32

            CrosshairState.Enabled =
                data.enabled ~= false

            applyCrosshairImage(
                CrosshairState.ImageID
            )

            applyCrosshairSize(
                CrosshairState.Size
            )

            applyCrosshairVisible(
                CrosshairState.Enabled
            )

            Rayfield:Notify({

                Title =
                    "Cursor Loaded",

                Content =
                    name,

                Duration = 2
            })
        end
    })

TabCrosshair:CreateButton({

    Name =
        "Delete Selected Cursor",

    Callback = function()

        if not SelectedCursor then

            Rayfield:Notify({

                Title =
                    "Crosshair",

                Content =
                    "Select a cursor first.",

                Duration = 3
            })

            return
        end

        local previous =
            SelectedCursor

        CrosshairState
            .SavedCursors[
                previous
            ] =
            nil

        saveCursors()

        SelectedCursor =
            nil

        if CursorDropdown then

            pcall(function()

                CursorDropdown:Refresh(
                    getCursorNames()
                )

            end)
        end

        Rayfield:Notify({

            Title =
                "Cursor Deleted",

            Content =
                previous,

            Duration = 2
        })
    end
})

--==============================================================
-- CONFIG TAB
--==============================================================

local ConfigDropdown
local ConfigNameInput = ""

local configNames =
    getConfigNames()

local function refreshConfigDropdown()

    configNames =
        getConfigNames()

    if ConfigDropdown then

        pcall(function()

            ConfigDropdown:Refresh(
                configNames
            )

        end)
    end
end

ConfigDropdown =
    TabConfig:CreateDropdown({

        Name =
            "Select Config",

        Options =
            configNames,

        CurrentOption = {},

        MultipleOptions =
            false,

        Callback = function(options)

            SelectedConfig =
                options
                and options[1]
        end
    })

TabConfig:CreateInput({

    Name =
        "Config Name",

    PlaceholderText =
        "my_config",

    RemoveTextAfterFocusLost =
        false,

    Callback = function(text)

        ConfigNameInput =
            text
    end
})

--==============================================================
-- CONFIG CREATE
--==============================================================

TabConfig:CreateButton({

    Name =
        "Create Config",

    Callback = function()

        local name =
            ConfigNameInput:
            match(
                "^%s*(.-)%s*$"
            )

        if name == "" then

            Rayfield:Notify({

                Title =
                    "Config",

                Content =
                    "Enter a config name.",

                Duration = 3
            })

            return
        end

        if not hasFS() then

            Rayfield:Notify({

                Title =
                    "Config",

                Content =
                    "File system unavailable.",

                Duration = 3
            })

            return
        end

        if not isfolder(
            CONFIG_FOLDER
        ) then

            makefolder(
                CONFIG_FOLDER
            )
        end

        local path =
            CONFIG_FOLDER
            .. "/"
            .. name
            .. ".json"

        local success =
            pcall(function()

                writefile(
                    path,

                    HttpService:JSONEncode(
                        buildStateSnapshot()
                    )
                )

                local list =
                    getConfigNames()

                local exists =
                    false

                for _, existing in ipairs(
                    list
                ) do

                    if existing == name then

                        exists =
                            true

                        break
                    end
                end

                if not exists then

                    table.insert(
                        list,
                        name
                    )
                end

                saveManifest(
                    list
                )
            end)

        if not success then

            Rayfield:Notify({

                Title =
                    "Config",

                Content =
                    "Failed to create config.",

                Duration = 3
            })

            return
        end

        SelectedConfig =
            name

        refreshConfigDropdown()

        Rayfield:Notify({

            Title =
                "Config Created",

            Content =
                name,

            Duration = 2
        })
    end
})

--==============================================================
-- CONFIG LOAD
--==============================================================

TabConfig:CreateButton({

    Name =
        "Load Selected Config",

    Callback = function()

        if not SelectedConfig then

            Rayfield:Notify({

                Title =
                    "Config",

                Content =
                    "Select a config first.",

                Duration = 3
            })

            return
        end

        if not hasFS() then
            return
        end

        local path =
            CONFIG_FOLDER
            .. "/"
            .. SelectedConfig
            .. ".json"

        if not isfile(path) then

            Rayfield:Notify({

                Title =
                    "Config",

                Content =
                    "File not found.",

                Duration = 3
            })

            return
        end

        local success, snap =
            pcall(function()

                return HttpService:JSONDecode(
                    readfile(path)
                )
            end)

        if not success then

            Rayfield:Notify({

                Title =
                    "Config",

                Content =
                    "Invalid JSON.",

                Duration = 3
            })

            return
        end

        if not applySnapshot(
            snap
        ) then

            Rayfield:Notify({

                Title =
                    "Config",

                Content =
                    "Failed to apply config.",

                Duration = 3
            })

            return
        end

        Rayfield:Notify({

            Title =
                "Config Loaded",

            Content =
                SelectedConfig,

            Duration = 2
        })
    end
})

--==============================================================
-- CONFIG SAVE
--==============================================================

TabConfig:CreateButton({

    Name =
        "Save Selected Config",

    Callback = function()

        if not SelectedConfig then

            Rayfield:Notify({

                Title =
                    "Config",

                Content =
                    "Select a config first.",

                Duration = 3
            })

            return
        end

        if not hasFS() then
            return
        end

        local path =
            CONFIG_FOLDER
            .. "/"
            .. SelectedConfig
            .. ".json"

        local success =
            pcall(function()

                writefile(
                    path,

                    HttpService:JSONEncode(
                        buildStateSnapshot()
                    )
                )
            end)

        if success then

            Rayfield:Notify({

                Title =
                    "Config Saved",

                Content =
                    SelectedConfig,

                Duration = 2
            })

        else

            Rayfield:Notify({

                Title =
                    "Config",

                Content =
                    "Failed to save config.",

                Duration = 3
            })
        end
    end
})

--==============================================================
-- CONFIG DELETE
--==============================================================

TabConfig:CreateButton({

    Name =
        "Delete Selected Config",

    Callback = function()

        if not SelectedConfig then

            Rayfield:Notify({

                Title =
                    "Config",

                Content =
                    "Select a config first.",

                Duration = 3
            })

            return
        end

        if not hasFS() then
            return
        end

        local selected =
            SelectedConfig

        local path =
            CONFIG_FOLDER
            .. "/"
            .. selected
            .. ".json"

        pcall(function()

            if isfile(path) then
                delfile(path)
            end
        end)

        local list =
            getConfigNames()

        for i, name in ipairs(
            list
        ) do

            if name == selected then

                table.remove(
                    list,
                    i
                )

                break
            end
        end

        saveManifest(
            list
        )

        SelectedConfig =
            nil

        refreshConfigDropdown()

        Rayfield:Notify({

            Title =
                "Config Deleted",

            Content =
                selected,

            Duration = 2
        })
    end
})

