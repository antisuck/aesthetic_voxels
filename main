TabMining:CreateSection(
    "Fast Break"
)

TabMining:CreateToggle({

    Name = "Fast Break",

    CurrentValue =
        State.FastBreak,

    Flag = "FastBreakToggle",

    Callback = function(value)

        State.FastBreak =
            value

        if value then

            local success =
                enableFastBreak()

            if not success then

                State.FastBreak =
                    false

                Rayfield:Notify({

                    Title =
                        "Fast Break",

                    Content =
                        "GetBreakingTime or hookfunction is unavailable.",

                    Duration = 3
                })
            end

        else

            disableFastBreak()
        end
    end
})

TabMining:CreateInput({

    Name = "Break Speed",

    PlaceholderText =
        "0 = instant",

    CurrentValue =
        tostring(
            State.BreakSpeed
        ),

    RemoveTextAfterFocusLost =
        false,

    Flag =
        "InputBreakSpeed",

    Callback = function(text)

        local value =
            tonumber(text)

        if value ~= nil then

            State.BreakSpeed =
                math.max(
                    value,
                    0
                )
        end
    end
})

--==============================================================
-- IGNORE MATERIALS
--==============================================================

TabMining:CreateSection(
    "Ignore Materials"
)

local IgnoreMaterialDropdown

local function getIgnoredMaterialNames()

    local result = {}

    for name, enabled in pairs(
        ignoredMaterials
    ) do

        if enabled then

            table.insert(
                result,
                name
            )
        end
    end

    table.sort(result)

    return result
end

IgnoreMaterialDropdown =
    TabMining:CreateDropdown({

        Name =
            "Materials",

        Options =
            materialList,

        CurrentOption = {},

        MultipleOptions =
            true,

        Flag =
            "IgnoredMaterials",

        Callback = function(options)

            for _, name in ipairs(
                materialList
            ) do

                ignoredMaterials[name] =
                    false
            end

            if type(options) ==
                "table" then

                for _, name in ipairs(
                    options
                ) do

                    ignoredMaterials[name] =
                        true
                end
            end
        end
    })

TabMining:CreateButton({

    Name =
        "Clear Ignore List",

    Callback = function()

        for _, name in ipairs(
            materialList
        ) do

            ignoredMaterials[name] =
                false
        end

        if IgnoreMaterialDropdown then

            pcall(function()

                IgnoreMaterialDropdown:Set(
                    {}
                )

            end)
        end

        Rayfield:Notify({

            Title =
                "Mining",

            Content =
                "Ignore list cleared.",

            Duration = 2
        })
    end
})

TabMining:CreateParagraph({

    Title =
        "Ignore Materials",

    Content =
        "Selected materials use the original game breaking time instead of Fast Break."
})

