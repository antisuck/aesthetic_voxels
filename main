})

TabCrosshair:CreateDivider()

TabCrosshair:CreateInput({
    Name                    = "Cursor Name (for saving)",
    PlaceholderText         = "e.g. Minecraft",
    RemoveTextAfterFocusLost = false,
    Callback                = function(t) CrosshairState.CursorName = t end
})

TabCrosshair:CreateButton({
    Name     = "Save Cursor",
    Callback = function()
        local name = CrosshairState.CursorName:match("^%s*(.-)%s*$")
        local id   = CrosshairState.ImageID:match("^%s*(.-)%s*$")
        if name == "" then
            Rayfield:Notify({ Title = "Crosshair", Content = "Enter a cursor name.", Duration = 3 })
            return
        end
        if id == "" then
            Rayfield:Notify({ Title = "Crosshair", Content = "Enter an Asset ID.", Duration = 3 })
            return
        end
        CrosshairState.SavedCursors[name] = {
            id      = id,
            size    = CrosshairState.Size,
            enabled = CrosshairState.Enabled,
        }
        saveCursors()
        Rayfield:Notify({ Title = "Cursor Saved", Content = name, Duration = 2 })
    end
})

local SelectedCursor = nil
local CursorDropdown

CursorDropdown = TabCrosshair:CreateDropdown({
    Name            = "Saved Cursors",
    Options         = getCursorNames(),
    CurrentOption   = {},
    MultipleOptions = false,
    Callback        = function(opts)
        local name = opts and opts[1]
        if not name then return end
        SelectedCursor = name
        local data = CrosshairState.SavedCursors[name]
        if not data then return end
        CrosshairState.ImageID  = tostring(data.id or "")
        CrosshairState.Size     = tonumber(data.size) or 32
        CrosshairState.Enabled  = data.enabled ~= false
        applyCrosshairImage(CrosshairState.ImageID)
        applyCrosshairSize(CrosshairState.Size)
        applyCrosshairVisible(CrosshairState.Enabled)
        Rayfield:Notify({ Title = "Cursor Loaded", Content = name, Duration = 2 })
    end
})

TabCrosshair:CreateButton({
    Name     = "Delete Selected Cursor",
    Callback = function()
        if not SelectedCursor then
            Rayfield:Notify({ Title = "Crosshair", Content = "Select a cursor first.", Duration = 3 })
            return
        end
        CrosshairState.SavedCursors[SelectedCursor] = nil
        saveCursors()
        local prev = SelectedCursor
        SelectedCursor = nil
        if CursorDropdown then
            CursorDropdown:Refresh(getCursorNames())
        end
        Rayfield:Notify({ Title = "Cursor Deleted", Content = prev, Duration = 2 })
    end
})

--==============================================================
-- TAB: CONFIG
--==============================================================

local ConfigDropdown
local configNames = getConfigNames()
local ConfigNameInput = ""

local function refreshConfigDropdown()
    configNames = getConfigNames()
    if ConfigDropdown then
        ConfigDropdown:Refresh(configNames)
    end
end

ConfigDropdown = TabConfig:CreateDropdown({
    Name            = "Select Config",
    Options         = configNames,
    CurrentOption   = {},
    MultipleOptions = false,
    Callback        = function(opts)
        SelectedConfig = opts and opts[1]
    end
})

TabConfig:CreateInput({
    Name                    = "Config Name",
    PlaceholderText         = "e.g. my_rage_config",
    RemoveTextAfterFocusLost = false,
    Callback                = function(t) ConfigNameInput = t end
})

TabConfig:CreateButton({
    Name     = "Create Config",
    Callback = function()
        local name = ConfigNameInput:match("^%s*(.-)%s*$")
        if name == "" then
            Rayfield:Notify({ Title = "Config", Content = "Enter a config name.", Duration = 3 })
            return
        end
        if not hasFS() then
            Rayfield:Notify({ Title = "Config", Content = "File system not available.", Duration = 3 })
            return
        end
        if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
        local path = CONFIG_FOLDER .. "/" .. name .. ".json"
        writefile(path, HttpService:JSONEncode(buildStateSnapshot()))
        local list = getConfigNames()
        table.insert(list, name)
        saveManifest(list)
        refreshConfigDropdown()
        Rayfield:Notify({ Title = "Config Created", Content = name, Duration = 2 })
    end
})

TabConfig:CreateButton({
    Name     = "Load Selected Config",
    Callback = function()
        if not SelectedConfig then
            Rayfield:Notify({ Title = "Config", Content = "Select a config first.", Duration = 3 })
            return
        end
        if not hasFS() then return end
        local path = CONFIG_FOLDER .. "/" .. SelectedConfig .. ".json"
        if not isfile(path) then
            Rayfield:Notify({ Title = "Config", Content = "File not found.", Duration = 3 })
            return
        end
        local snap = HttpService:JSONDecode(readfile(path))
        applySnapshot(snap)
        Rayfield:Notify({ Title = "Config Loaded", Content = SelectedConfig, Duration = 2 })
    end
})

TabConfig:CreateButton({
    Name     = "Delete Selected Config",
    Callback = function()
        if not SelectedConfig then
            Rayfield:Notify({ Title = "Config", Content = "Select a config first.", Duration = 3 })
            return
        end
        if not hasFS() then return end
        local path = CONFIG_FOLDER .. "/" .. SelectedConfig .. ".json"
        if isfile(path) then
            delfile(path)
        end
        local list = getConfigNames()
        for i, v in ipairs(list) do
            if v == SelectedConfig then
                table.remove(list, i)
                break
            end
        end
        saveManifest(list)
        local prev = SelectedConfig
        SelectedConfig = nil
        refreshConfigDropdown()
        Rayfield:Notify({ Title = "Config Deleted", Content = prev, Duration = 2 })
    end
})

