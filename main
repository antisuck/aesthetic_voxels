    task.wait(0.5)

    applyCharacterStats()

    if State.FlyEnabled then

        task.wait(0.25)

        enableFly()
    end
end)

--==============================================================
-- MINING
--==============================================================

local ignoredMaterials =
    State.IgnoreMaterials

local materialList = {}

local fastBreakOldFunction =
    nil

local fastBreakHooked =
    false

--==============================================================
-- MATERIAL LIST
--==============================================================

pcall(function()

    local compiled =
        MaterialService:FindFirstChild(
            "CompiledMaterials"
        )

    if compiled then

        for _, material in ipairs(
            compiled:GetChildren()
        ) do

            local name =
                material.Name

            if not ignoredMaterials[name] then
                ignoredMaterials[name] =
                    false
            end

            table.insert(
                materialList,
                name
            )
        end
    end
end)

table.sort(
    materialList
)

--==============================================================
-- LOOK PART
--==============================================================

local function getMiningLookPart()

    if not Camera then
        return nil
    end

    local viewport =
        Camera.ViewportSize

    local ray =
        Camera:ViewportPointToRay(
            viewport.X / 2,
            viewport.Y / 2
        )

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    local character =
        LocalPlayer.Character

    if character then

        params.FilterDescendantsInstances =
            {
                character
            }
    end

    local result =
        workspace:Raycast(
            ray.Origin,
            ray.Direction * 20,
            params
        )

    if result then
        return result.Instance
    end

    return nil
end

--==============================================================
-- MATERIAL CHECK
--==============================================================

local function isMaterialIgnored(part)

    if not part
        or not part:IsA("BasePart") then

        return false
    end

    local variant =
        part.MaterialVariant

    if not variant
        or variant == "" then

        return false
    end

    return ignoredMaterials[
        variant
    ] == true
end

--==============================================================
-- FAST BREAK
--==============================================================

local function enableFastBreak()

    if fastBreakHooked then
        return true
    end

    if typeof(hookfunction) ~=
        "function" then

        return false
    end

    local ok, getBreakingTime =
        pcall(function()

            return require(
                ReplicatedStorage
                    .Systems
                    .ItemsSystem
                    .Libs
                    .GetBreakingTime
            )
        end)

    if not ok
        or typeof(getBreakingTime) ~=
        "function" then

        return false
    end

    local original =
        getBreakingTime

    local oldFunction

    local success =
        pcall(function()

            oldFunction =
                hookfunction(
                    original,

                    function(...)

                        local part =
                            getMiningLookPart()

                        if isMaterialIgnored(
                            part
                        ) then

                            return original(...)
                        end

                        return State.BreakSpeed
                    end
                )
        end)

    if not success then
        return false
    end

    fastBreakOldFunction =
        oldFunction

    fastBreakHooked =
        true

    return true
end

local function disableFastBreak()

    if not fastBreakHooked then
        return
    end

    if typeof(hookfunction) ~=
        "function" then

        return
    end

    pcall(function()

        local getBreakingTime =
            require(
                ReplicatedStorage
                    .Systems
                    .ItemsSystem
                    .Libs
                    .GetBreakingTime
            )

        if fastBreakOldFunction then

            hookfunction(
                getBreakingTime,
                fastBreakOldFunction
            )
        end
    end)

    fastBreakOldFunction =
        nil

    fastBreakHooked =
        false
end

--==============================================================
-- CROSSHAIR
--==============================================================

local CrosshairState = {

    Enabled = true,

    Size = 32,

    ImageID = "",

    CursorName = "",

    SavedCursors = {}
}

local CURSOR_FOLDER =
    "aesthetic"

local CURSOR_FILE =
    "aesthetic/cursors.json"

--==============================================================
-- FILESYSTEM
--==============================================================

local function hasFS()

    return type(isfile) == "function"
        and type(readfile) == "function"
        and type(writefile) == "function"
        and type(isfolder) == "function"
        and type(makefolder) == "function"
end

--==============================================================
-- CURSOR LOAD
--==============================================================

local function loadCursors()

    CrosshairState.SavedCursors =
        {}

    if not hasFS() then
        return
    end

    pcall(function()

        if not isfolder(
            CURSOR_FOLDER
        ) then

            makefolder(
                CURSOR_FOLDER
            )
        end

        if not isfile(
            CURSOR_FILE
        ) then

            writefile(
                CURSOR_FILE,
                "{}"
            )

            return
        end

        local raw =
            readfile(
                CURSOR_FILE
            )

        if raw == "" then
            return
        end

        local data =
            HttpService:JSONDecode(
                raw
            )

        if type(data) ==
            "table" then

            CrosshairState.SavedCursors =
                data
        end
    end)
end

local function saveCursors()

    if not hasFS() then
        return false
    end

    return pcall(function()

        if not isfolder(
            CURSOR_FOLDER
        ) then

            makefolder(
                CURSOR_FOLDER
            )
        end

        writefile(
            CURSOR_FILE,
            HttpService:JSONEncode(
                CrosshairState.SavedCursors
            )
        )
    end)
end

loadCursors()

--==============================================================
-- CROSSHAIR OBJECT
--==============================================================

local function getImageObj()

    local pg =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    if not pg then
        return nil
    end

    local camGui =
        pg:FindFirstChild(
            "CameraGui"
        )

    if not camGui then
        return nil
    end

    local crosshair =
        camGui:FindFirstChild(
            "Crosshair"
        )

    if not crosshair then
        return nil
    end

    if crosshair:IsA(
        "ImageLabel"
    )
    or crosshair:IsA(
        "ImageButton"
    ) then

        return crosshair
    end

    return crosshair:
        FindFirstChildWhichIsA(
            "ImageLabel",
            true
        )
        or crosshair:
        FindFirstChildWhichIsA(
            "ImageButton",
            true
        )
end

--==============================================================
-- CROSSHAIR APPLY
--==============================================================

local function applyCrosshairImage(id)

    local obj =
        getImageObj()

    if not obj then
        return false
    end

    id =
        tostring(
            id or ""
        ):match(
            "^%s*(.-)%s*$"
        )

    if id == "" then
        return false
    end

    if id:match(
        "^rbxassetid://"
    ) then

        obj.Image =
            id

    else

        obj.Image =
            "rbxassetid://"
            .. id
    end

    return true
end

local function applyCrosshairSize(size)

    local obj =
        getImageObj()

    CrosshairState.Size =
        math.clamp(
            tonumber(size) or 32,
            8,
            200
        )

    if not obj then
        return
    end

    local camGui =
        PlayerGui:FindFirstChild(
            "CameraGui"
        )

    local crosshair =
        camGui
        and camGui:FindFirstChild(
            "Crosshair"
        )

    local scale =
        crosshair
        and crosshair:
        FindFirstChildWhichIsA(
            "UIScale",
            true
        )

    if scale then

        scale.Scale =
            CrosshairState.Size
            / 32

    else

        obj.Size =
            UDim2.fromOffset(
                CrosshairState.Size,
                CrosshairState.Size
            )
    end
end

local function applyCrosshairVisible(value)

    CrosshairState.Enabled =
        value == true

    local obj =
        getImageObj()

    if obj then
        obj.Visible =
            CrosshairState.Enabled
    end
end

local function getCursorNames()

    local names = {}

    for name, data in pairs(
        CrosshairState.SavedCursors
    ) do

        if type(data) == "table"
            and data.id then

            table.insert(
                names,
                name
            )
        end
    end

    table.sort(names)

    return names
end

--==============================================================
-- CONFIG
--==============================================================

local CONFIG_FOLDER =
    "aesthetic"

local SelectedConfig =
    nil

local function getConfigNames()

    local names = {}

    if not hasFS() then
        return names
    end

    pcall(function()

        if not isfolder(
            CONFIG_FOLDER
        ) then

            makefolder(
                CONFIG_FOLDER
            )
        end

        -- Read manifest

        local manifestPath =
            CONFIG_FOLDER
            .. "/manifest.json"

        if isfile(
            manifestPath
        ) then

            local raw =
                readfile(
                    manifestPath
                )

            if raw ~= "" then

                local data =
                    HttpService:JSONDecode(
                        raw
                    )

                if type(data) ==
                    "table" then

                    for _, name in ipairs(
                        data
                    ) do

                        if type(name) ==
                            "string"
                            and name ~= "" then

                            table.insert(
                                names,
                                name
                            )
                        end
                    end
                end
            end
        end
    end)

    table.sort(names)

    return names
end

local function saveManifest(list)

    if not hasFS() then
        return false
    end

    return pcall(function()

        if not isfolder(
            CONFIG_FOLDER
        ) then

            makefolder(
                CONFIG_FOLDER
            )
        end

        writefile(
            CONFIG_FOLDER
            .. "/manifest.json",

            HttpService:JSONEncode(
                list
            )
        )
    end)
end

--==============================================================
-- STATE SNAPSHOT
--==============================================================

local function buildStateSnapshot()

    return {

        ESPEnabled =
            State.ESPEnabled,

        ESPColor = {
            State.ESPColor.R,
            State.ESPColor.G,
            State.ESPColor.B
        },

        FOVEnabled =
            State.FOVEnabled,

        FOVSize =
            State.FOVSize,

        FOVRainbow =
            State.FOVRainbow,

        FOVColor = {
            State.FOVColor.R,
            State.FOVColor.G,
            State.FOVColor.B
        },

        KillAura =
            State.KillAura,

        KillAuraRange =
            State.KillAuraRange,

        AttackDelay =
            State.AttackDelay,

        AimbotEnabled =
            State.AimbotEnabled,

        NoFallDamage =
            State.NoFallDamage,

        NoDrowDamage =
            State.NoDrowDamage,

        FlyEnabled =
            State.FlyEnabled,

        FlySpeed =
            State.FlySpeed,

        Speed =
            State.Speed,

        JumpPower =
            State.JumpPower,

        FastBreak =
            State.FastBreak,

        BreakSpeed =
            State.BreakSpeed,

        IgnoreMaterials =
            State.IgnoreMaterials
    }
end

--==============================================================
-- APPLY SNAPSHOT
--==============================================================

local function applySnapshot(snap)

    if type(snap) ~= "table" then
        return false
    end

    State.ESPEnabled =
        snap.ESPEnabled == true

    State.FOVEnabled =
        snap.FOVEnabled == true

    State.FOVSize =
        math.clamp(
            tonumber(
                snap.FOVSize
            ) or 120,
            20,
            600
        )

    State.FOVRainbow =
        snap.FOVRainbow == true

    if type(
        snap.ESPColor
    ) == "table" then

        State.ESPColor =
            Color3.new(
                tonumber(
                    snap.ESPColor[1]
                ) or 1,

                tonumber(
                    snap.ESPColor[2]
                ) or 0,

                tonumber(
                    snap.ESPColor[3]
                ) or 0
            )
    end

    if type(
        snap.FOVColor
    ) == "table" then

        State.FOVColor =
            Color3.new(
                tonumber(
                    snap.FOVColor[1]
                ) or 1,

                tonumber(
                    snap.FOVColor[2]
                ) or 1,

                tonumber(
                    snap.FOVColor[3]
                ) or 1
            )
    end

    State.KillAura =
        snap.KillAura == true

    State.KillAuraRange =
        math.clamp(
            tonumber(
                snap.KillAuraRange
            ) or 24,
            4,
            60
        )

    State.AttackDelay =
        math.max(
            tonumber(
                snap.AttackDelay
            ) or 0.35,
            0.01
        )

    State.AimbotEnabled =
        snap.AimbotEnabled == true

    State.NoFallDamage =
        snap.NoFallDamage == true

    State.NoDrowDamage =
        snap.NoDrowDamage == true

    State.FlyEnabled =
        snap.FlyEnabled == true

    State.FlySpeed =
        math.clamp(
            tonumber(
                snap.FlySpeed
            ) or 16,
            1,
            200
        )

    State.Speed =
        math.clamp(
            tonumber(
                snap.Speed
            ) or 16,
            1,
            200
        )

    State.JumpPower =
        math.clamp(
            tonumber(
                snap.JumpPower
            ) or 50,
            1,
            500
        )

    State.FastBreak =
        snap.FastBreak == true

    State.BreakSpeed =
        math.max(
            tonumber(
                snap.BreakSpeed
            ) or 0,
            0
        )

    -- Ignore materials

    table.clear(
        State.IgnoreMaterials
    )

    if type(
        snap.IgnoreMaterials
    ) == "table" then

        for name, enabled in pairs(
            snap.IgnoreMaterials
        ) do

            if type(name) == "string" then

                State.IgnoreMaterials[name] =
                    enabled == true
            end
        end
    end

    -- Apply

    applyCharacterStats()

    if State.FastBreak then
        enableFastBreak()
    else
        disableFastBreak()
    end

    if State.FlyEnabled then
        enableFly()
    else
        disableFly()
    end

    return true
end

