--==============================================================
-- KILL AURA
--==============================================================

local ActionsSystem =
    ReplicatedStorage
    :WaitForChild("Systems")
    :WaitForChild("ActionsSystem")


local AttackRemote =
    ActionsSystem
    :WaitForChild("Network")
    :WaitForChild("Attack")


local KillAuraEnabled = false


local function GetNearestTarget()

    local character =
        LocalPlayer.Character


    if not character then
        return nil
    end


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )
        or character.PrimaryPart


    if not root then
        return nil
    end


    local nearest = nil

    local nearestDistance =
        Settings.KillAuraRange


    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            local target =
                player.Character


            if target then

                local targetRoot =
                    target:FindFirstChild(
                        "HumanoidRootPart"
                    )
                    or target.PrimaryPart


                local humanoid =
                    target:FindFirstChildOfClass(
                        "Humanoid"
                    )


                if targetRoot
                    and humanoid
                    and humanoid.Health > 0 then

                    local distance =
                        (
                            targetRoot.Position -
                            root.Position
                        ).Magnitude


                    if distance <= nearestDistance then

                        nearest =
                            target

                        nearestDistance =
                            distance

                    end
                end
            end
        end
    end


    return nearest
end


--==============================================================
-- KILL AURA LOOP
--==============================================================

task.spawn(
    function()

        while task.wait(
            math.max(
                Settings.KillAuraDelay,
                0.05
            )
        ) do

            if KillAuraEnabled then

                local target =
                    GetNearestTarget()


                if target then

                    local character =
                        LocalPlayer.Character


                    local hotbarSlot =
                        character
                        and character:GetAttribute(
                            "ReplicatedHotbarSlot"
                        )


                    if hotbarSlot then

                        pcall(function()

                            AttackRemote:InvokeServer(
                                target,
                                tostring(
                                    hotbarSlot
                                )
                            )

                        end)

                    end
                end
            end
        end
    end
)


--==============================================================
-- FOV CIRCLE
--==============================================================

local FOVCircle =
    Drawing.new("Circle")


FOVCircle.Visible = false

FOVCircle.Filled = false

FOVCircle.NumSides = 64

FOVCircle.Thickness = 1.5


RunService.RenderStepped:Connect(
    function()

        Camera =
            Workspace.CurrentCamera


        if not KillAuraEnabled
            or not Settings.ShowFOV then

            FOVCircle.Visible = false

            return
        end


        FOVCircle.Visible = true

        FOVCircle.Color =
            Settings.FOVColor

        FOVCircle.Radius =
            Settings.FOVRadius


        FOVCircle.Position =
            Vector2.new(
                Camera.ViewportSize.X / 2,
                Camera.ViewportSize.Y / 2
            )

    end
)


