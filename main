                Content =
                    "CameraGui/Crosshair was not found.",

                Duration = 3
            })

            return
        end

        applyCrosshairSize(
            CrosshairState.Size
        )

        applyCrosshairVisible(
            CrosshairState.Enabled
        )

        Rayfield:Notify({

            Title =
                "Crosshair",

            Content =
                "Cursor applied.",

            Duration = 2
        })
    end
})

