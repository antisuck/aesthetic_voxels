--==============================================================
-- HYBRID ESP
-- Character Parts Bounding Box
-- Fallback: LastPosition
--==============================================================

local ESPObjects = {}

local ESPSettings = {
    MaxDistance = 2500,

    BoxColor = State.ESPColor,
    TextColor = Color3.fromRGB(255, 255, 255),

    BoxThickness = 2,

    -- Плавность позиции ESP
    Smoothness = 0.25,

    -- Сколько времени терпим временную потерю Character
    GraceTime = 0.15,
}

--==============================================================
-- ESP FOLDER
--==============================================================

local ESPFolder =
    workspace:FindFirstChild("HybridESP")
    or Instance.new("Folder")

ESPFolder.Name = "HybridESP"
ESPFolder.Parent = workspace

--==============================================================
-- HEALTH COLOR
--==============================================================

local function getESPHealthColor(percent)

    if percent > 0.60 then
        return Color3.fromRGB(60, 255, 110)

    elseif percent > 0.30 then
        return Color3.fromRGB(255, 220, 60)

    else
        return Color3.fromRGB(255, 60, 60)
    end
end

--==============================================================
-- GET CHARACTER PARTS
--==============================================================

local function getCharacterParts(character)

    if not character then
        return {}
    end

    local parts = {}

    for _, obj in ipairs(character:GetDescendants()) do

        if obj:IsA("BasePart")
            and obj.Transparency < 1 then

            table.insert(parts, obj)

        end
    end

    return parts
end

--==============================================================
-- GET SCREEN BOUNDING BOX
--==============================================================

local function getHybridBoundingBox(character)

    local parts = getCharacterParts(character)

    if #parts == 0 then
        return nil
    end

    local minX = math.huge
    local minY = math.huge

    local maxX = -math.huge
    local maxY = -math.huge

    local visiblePoints = 0

    for _, part in ipairs(parts) do

        local cf = part.CFrame
        local size = part.Size / 2

        -- Все 8 углов BasePart
        local corners = {
            Vector3.new(-size.X, -size.Y, -size.Z),
            Vector3.new(-size.X, -size.Y,  size.Z),
            Vector3.new(-size.X,  size.Y, -size.Z),
            Vector3.new(-size.X,  size.Y,  size.Z),

            Vector3.new( size.X, -size.Y, -size.Z),
            Vector3.new( size.X, -size.Y,  size.Z),
            Vector3.new( size.X,  size.Y, -size.Z),
            Vector3.new( size.X,  size.Y,  size.Z),
        }

        for _, corner in ipairs(corners) do

            local worldPosition =
                cf:PointToWorldSpace(corner)

            local screenPosition, onScreen =
                Camera:WorldToViewportPoint(
                    worldPosition
                )

            if onScreen and screenPosition.Z > 0 then

                visiblePoints += 1

                minX = math.min(
                    minX,
                    screenPosition.X
                )

                minY = math.min(
                    minY,
                    screenPosition.Y
                )

                maxX = math.max(
                    maxX,
                    screenPosition.X
                )

                maxY = math.max(
                    maxY,
                    screenPosition.Y
                )
            end
        end
    end

    if visiblePoints < 2 then
        return nil
    end

    local width =
        maxX - minX

    local height =
        maxY - minY

    -- Защита от кривых/нулевых размеров
    if width < 2 or height < 2 then
        return nil
    end

    return {
        X = minX,
        Y = minY,

        Width = width,
        Height = height,

        CenterX = (minX + maxX) / 2,
        CenterY = (minY + maxY) / 2,
    }
end

--==============================================================
-- CREATE ESP
--==============================================================

local function createESP(player)

    if player == LocalPlayer then
        return
    end

    if ESPObjects[player] then
        return
