local function applyCharacterStats()

    local character =
        LocalPlayer.Character

    if not character then
        return
    end

    local humanoid =
        getHumanoid(character)

    if not humanoid then
        return
    end

    pcall(function()

        humanoid.WalkSpeed =
            State.Speed

        humanoid.UseJumpPower =
            true

        humanoid.JumpPower =
            State.JumpPower

    end)
end

