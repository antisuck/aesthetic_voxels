        2
    },

    Increment = 0.05,

    Suffix = " sec",

    CurrentValue =
        Settings.KillAuraDelay,

    Callback = function(value)

        Settings.KillAuraDelay =
            value

    end
})


--==============================================================
-- MOBILE FLY
--==============================================================

local FlyConnection = nil
local FlyVelocity = nil
local FlyAttachment = nil


local FlyInput = {

    Forward = false,
    Backward = false,

    Left = false,
    Right = false,

    Up = false,
    Down = false
}


local function StopFly()

    if FlyConnection then

        FlyConnection:Disconnect()

        FlyConnection = nil

    end


    if FlyVelocity then

        pcall(function()
            FlyVelocity:Destroy()
        end)

        FlyVelocity = nil

    end


    if FlyAttachment then

        pcall(function()
            FlyAttachment:Destroy()
        end)

        FlyAttachment = nil

    end

end


local function StartFly()

    StopFly()


    local character =
        LocalPlayer.Character


    if not character then
        return
    end


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )


    if not root then
        return
    end


    FlyAttachment =
        Instance.new("Attachment")


    FlyAttachment.Name =
        "VoxelFlyAttachment"

    FlyAttachment.Parent =
        root


    FlyVelocity =
        Instance.new("LinearVelocity")


    FlyVelocity.Name =
        "VoxelFlyVelocity"

    FlyVelocity.Attachment0 =
        FlyAttachment

    FlyVelocity.MaxForce =
        math.huge

    FlyVelocity.RelativeTo =
        Enum.ActuatorRelativeTo.World

    FlyVelocity.VectorVelocity =
        Vector3.zero

    FlyVelocity.Parent =
        root


    FlyConnection =
        RunService.RenderStepped:Connect(
            function()

                if not Settings.Fly then
                    return
                end


                if not root
                    or not root.Parent then

                    return

                end


                local camera =
                    Workspace.CurrentCamera


                local forward =
                    Vector3.zero

                local right =
                    Vector3.zero

                local vertical =
                    0


                if FlyInput.Forward then
                    forward +=
                        camera.CFrame.LookVector
                end


                if FlyInput.Backward then
                    forward -=
                        camera.CFrame.LookVector
                end


                if FlyInput.Right then
                    right +=
                        camera.CFrame.RightVector
                end


                if FlyInput.Left then
                    right -=
                        camera.CFrame.RightVector
                end


                if FlyInput.Up then
                    vertical += 1
                end


                if FlyInput.Down then
                    vertical -= 1
                end


                local direction =
                    forward + right


                if direction.Magnitude > 1 then
                    direction =
                        direction.Unit
                end


                FlyVelocity.VectorVelocity =
                    direction *
                    Settings.FlySpeed
                    +
                    Vector3.new(
                        0,
                        vertical *
                        Settings.FlySpeed,
                        0
                    )

            end
        )

end


--==============================================================
-- MOBILE FLY GUI
--==============================================================

local FlyGui =
    Instance.new("ScreenGui")


FlyGui.Name =
    "VoxelCombatMobileFly"

FlyGui.ResetOnSpawn =
    false

FlyGui.IgnoreGuiInset =
    true

FlyGui.Enabled =
    false

FlyGui.Parent =
    LocalPlayer:WaitForChild(
        "PlayerGui"
    )


local FlyFrame =
    Instance.new("Frame")


FlyFrame.Name =
    "FlyControls"

FlyFrame.Size =
    UDim2.fromOffset(
        220,
        220
    )

FlyFrame.Position =
    UDim2.new(
        0,
        20,
        1,
        -240
    )

FlyFrame.BackgroundTransparency =
    1

FlyFrame.Parent =
    FlyGui


local function CreateFlyButton(
    name,
    text,
    position,
    inputName
)

    local button =
        Instance.new("TextButton")


    button.Name =
        name

    button.Text =
        text

    button.Size =
        UDim2.fromOffset(
            65,
            65
        )

    button.Position =
        position

    button.BackgroundTransparency =
        0.2

    button.TextScaled =
        true

    button.TextColor3 =
        Color3.fromRGB(
            255,
            255,
            255
        )

    button.BackgroundColor3 =
        Color3.fromRGB(
            25,
            25,
            25
        )

    button.BorderSizePixel =
        0

    button.Parent =
        FlyFrame


    local corner =
        Instance.new("UICorner")


    corner.CornerRadius =
        UDim.new(
            0,
            14
        )

    corner.Parent =
        button


    local function setState(state)

        FlyInput[inputName] =
            state


        if state then

            button.BackgroundColor3 =
                Color3.fromRGB(
                    70,
                    70,
                    70
                )

        else

            button.BackgroundColor3 =
                Color3.fromRGB(
                    25,
                    25,
                    25
                )

        end

    end


    button.InputBegan:Connect(
        function(input)

            if input.UserInputType ==
                Enum.UserInputType.Touch
                or
                input.UserInputType ==
                Enum.UserInputType.MouseButton1 then

                setState(true)

            end

        end
    )


    button.InputEnded:Connect(
        function(input)

            if input.UserInputType ==
                Enum.UserInputType.Touch
                or
                input.UserInputType ==
                Enum.UserInputType.MouseButton1 then

                setState(false)

            end

        end
    )


    return button

end


