--==============================================================
-- HIDE ESP
--==============================================================

local function hideESP(esp)

    if not esp then
        return
    end

    if esp.Gui then
        esp.Gui.Enabled = false
    end

    if esp.ScreenGui then
        esp.ScreenGui.Enabled = false
    end

    esp.Mode =
        "None"
end

--==============================================================
-- REMOVE ESP
--==============================================================

local function removeESP(player)

    local esp =
        ESPObjects[player]

    if not esp then
        return
    end

    safeDestroy(esp.ScreenGui)
    safeDestroy(esp.Part)

    ESPObjects[player] =
        nil
end

--==============================================================
-- LAST POSITION
--==============================================================

local function updateLastPosition(
    player,
    esp,
    distance
)

    local pos =
        player:GetAttribute(
            "LastPosition"
        )

    if typeof(pos) ~= "Vector3" then
        return false
    end

    esp.LastPos =
        pos

    if esp.Mode ~= "LastPosition" then

        esp.Part.Position =
            pos

        esp.Mode =
            "LastPosition"

    else

        esp.Part.Position =
            esp.Part.Position:Lerp(
                pos,
                ESPSettings.Smoothness
            )
    end

    esp.Gui.Enabled =
        true

    esp.BoxStroke.Color =
        State.ESPColor

    esp.NameText.Text =
        player.DisplayName

    esp.HealthBackground.Visible =
        false

    esp.HealthText.Visible =
        false

    esp.DistanceText.Visible =
        true

    esp.DistanceText.Text =
        math.floor(distance)
        .. " Stud"

    return true
end

--==============================================================
-- INITIAL ESP
--==============================================================

for _, player in ipairs(
    Players:GetPlayers()
) do

    createESP(player)

end

Players.PlayerAdded:Connect(function(player)

    createESP(player)

end)

Players.PlayerRemoving:Connect(function(player)

    removeESP(player)

end)

--==============================================================
-- CHARACTER EVENTS
--==============================================================

local function setupESPCharacter(player)

    if player == LocalPlayer then
        return
    end

    player.CharacterAdded:Connect(function()

        local esp =
            ESPObjects[player]

        if esp then

            esp.LastPos =
                nil

            esp.LastValidTime =
                os.clock()

            esp.Mode =
                "None"

            if esp.ScreenGui then
                esp.ScreenGui.Enabled =
                    false
            end

        end
    end)
end

for _, player in ipairs(
    Players:GetPlayers()
) do

    setupESPCharacter(player)

end

Players.PlayerAdded:Connect(function(player)

    setupESPCharacter(player)

end)

--==============================================================
-- ESP UPDATE
--==============================================================

RunService.RenderStepped:Connect(function()

    if not State.ESPEnabled then

        for _, esp in pairs(
            ESPObjects
        ) do

            hideESP(esp)

        end

        return
    end

    local localCharacter =
        LocalPlayer.Character

    local localRoot =
        getRoot(localCharacter)

    if not localRoot then
        return
    end

    for player, esp in pairs(
        ESPObjects
    ) do

        if player.Parent ~= Players then

            removeESP(player)

            continue
        end

        local character =
            player.Character

        local humanoid =
            getHumanoid(character)

        --======================================================
        -- REAL CHARACTER
        --======================================================

        local hybridBox

        if character then

            hybridBox =
                getHybridBoundingBox(
                    character
                )
        end

        if hybridBox then

            esp.Mode =
                "Hybrid"

            esp.Gui.Enabled =
                false

            createScreenESP(esp)

            esp.ScreenGui.Enabled =
                true

            local box =
                esp.ScreenBox

            local stroke =
                esp.ScreenStroke

            local name =
                esp.ScreenName

            local hp =
                esp.ScreenHealth

            local distanceLabel =
                esp.ScreenDistance

            -- BOX

            box.Position =
                UDim2.fromOffset(
                    hybridBox.X,
                    hybridBox.Y
                )

            box.Size =
                UDim2.fromOffset(
                    hybridBox.Width,
                    hybridBox.Height
                )

            stroke.Color =
                State.ESPColor

            -- NAME

            name.Position =
                UDim2.fromOffset(
                    hybridBox.CenterX,
                    hybridBox.Y - 4
                )

            name.Size =
                UDim2.fromOffset(
                    200,
                    18
                )

            name.Text =
                player.DisplayName

            -- HP

            local healthColor =
                Color3.fromRGB(
                    180,
                    180,
                    180
                )

            if humanoid
                and humanoid.MaxHealth > 0 then

                local health =
                    math.clamp(
                        humanoid.Health,
                        0,
                        humanoid.MaxHealth
                    )

                local maxHealth =
                    math.max(
                        humanoid.MaxHealth,
                        1
                    )

                local percent =
                    math.clamp(
                        health / maxHealth,
                        0,
                        1
                    )

                healthColor =
                    getESPHealthColor(
                        percent
                    )

                hp.Text =
                    string.format(
                        "%d / %d HP",
                        math.floor(health),
                        math.floor(maxHealth)
                    )

            else

                hp.Text =
                    "? HP"
            end

            hp.TextColor3 =
                healthColor

            hp.Position =
                UDim2.fromOffset(
                    hybridBox.X
                    + hybridBox.Width
                    + 6,

                    hybridBox.CenterY
                )

            hp.Size =
                UDim2.fromOffset(
                    90,
                    18
                )

            -- DISTANCE

            local worldPosition =
                getCharacterPosition(
                    character
                )

            if worldPosition then

                local distance =
                    (
                        localRoot.Position
                        - worldPosition
                    ).Magnitude

                distanceLabel.Position =
                    UDim2.fromOffset(
                        hybridBox.CenterX,
                        hybridBox.Y
                        + hybridBox.Height
                        + 4
                    )

                distanceLabel.Size =
                    UDim2.fromOffset(
                        100,
                        18
                    )

                distanceLabel.Text =
                    math.floor(distance)
                    .. " Stud"

                -- Save position
                player:SetAttribute(
                    "LastPosition",
                    worldPosition
                )

                esp.LastValidTime =
                    os.clock()
            end

            continue
        end

        --======================================================
        -- NO REAL CHARACTER
        --======================================================

        if esp.ScreenGui then
            esp.ScreenGui.Enabled =
                false
        end

        --======================================================
        -- FALLBACK
        --======================================================

        local lastPosition =
            player:GetAttribute(
                "LastPosition"
            )

        if typeof(lastPosition) ==
            "Vector3" then

            local distance =
                (
                    localRoot.Position
                    - lastPosition
                ).Magnitude

            if distance <=
                ESPSettings.MaxDistance then

                if updateLastPosition(
                    player,
                    esp,
                    distance
                ) then

                    continue
                end
            end
        end

        hideESP(esp)
    end
end)

