local Settings = {

    -- ESP
    ESPEnabled = true,

    BoxESP = true,
    SkeletonESP = false,
    HealthBar = true,
    HealthText = true,
    NameESP = true,
    DistanceESP = true,

    ESPColor = Color3.fromRGB(
        255,
        255,
        255
    ),

    TargetHighlight = true,

    TargetHighlightColor =
        Color3.fromRGB(
            255,
            80,
            80
        ),

    -- KILL AURA
    KillAura = false,

    KillAuraRange = 24,

    ShowFOV = true,

    FOVRadius = 100,

    FOVColor =
        Color3.fromRGB(
            255,
            80,
            80
        ),

    KillAuraDelay = 0.35,

    -- MOVEMENT
    Fly = false,

    FlySpeed = 50,

    Speed = 16,

    JumpPower = 50,

    Noclip = false,

    -- CONFIG
    CurrentConfig = "default",

    AutoLoadConfig = false
}


--==============================================================
-- CONFIG SYSTEM
--==============================================================

local ConfigFolder = "VoxelCombat"

local function EnsureConfigFolder()

    if not isfolder or not makefolder then
        return
    end

    if not isfolder(ConfigFolder) then

        pcall(function()
            makefolder(ConfigFolder)
        end)

    end
end


EnsureConfigFolder()


local function ConfigPath(name)

    return ConfigFolder ..
        "/" ..
        name ..
        ".json"

end


local function SerializeSettings()

    local data = {}

    for key, value in pairs(Settings) do

        if typeof(value) == "Color3" then

            data[key] = {
                R = value.R,
                G = value.G,
                B = value.B
            }

        else

            data[key] = value

        end
    end

    return data
end


local function ApplySettings(data)

    if type(data) ~= "table" then
        return
    end

    for key, value in pairs(data) do

        if Settings[key] ~= nil then

            if type(value) == "table"
                and value.R
                and value.G
                and value.B then

                Settings[key] = Color3.new(
                    value.R,
                    value.G,
                    value.B
                )

            else

                Settings[key] = value

            end
        end
    end
end


local function SaveConfig(name)

    if not writefile then
        return false
    end

    EnsureConfigFolder()

    local success = pcall(function()

        local data =
            HttpService:JSONEncode(
                SerializeSettings()
            )

        writefile(
            ConfigPath(name),
            data
        )

    end)

    return success
end


local function LoadConfig(name)

    if not readfile or not isfile then
        return false
    end

    local path =
        ConfigPath(name)

    if not isfile(path) then
        return false
    end

    local success = pcall(function()

        local data =
            readfile(path)

        local decoded =
            HttpService:JSONDecode(data)

        ApplySettings(decoded)

    end)

    return success
end


local function DeleteConfig(name)

    if not delfile or not isfile then
        return false
    end

    local path =
        ConfigPath(name)

    if not isfile(path) then
        return false
    end

    local success = pcall(function()

        delfile(path)

    end)

    return success
end


local function ConfigExists(name)

    if not isfile then
        return false
    end

    return isfile(
        ConfigPath(name)
    )
end


--==============================================================
-- ESP
--==============================================================

local ESPObjects = {}


local function NewDrawing(class)

    local object =
        Drawing.new(class)

    if class == "Square" then

        object.Visible = false
        object.Filled = false
        object.Thickness = 1.5

    elseif class == "Line" then

        object.Visible = false
        object.Thickness = 1.5

    elseif class == "Text" then

        object.Visible = false
        object.Center = true
        object.Outline = true
        object.Size = 13

    end

    return object
end


--==============================================================
-- CREATE ESP
--==============================================================

local function CreateESP(player)

    if player == LocalPlayer then
        return
    end

    if ESPObjects[player] then
        return
    end


    local esp = {

        Player = player,

        Box = NewDrawing("Square"),

        HealthBackground =
            NewDrawing("Square"),

        HealthBar =
            NewDrawing("Square"),

        Name =
            NewDrawing("Text"),

        Distance =
            NewDrawing("Text"),

        HealthText =
            NewDrawing("Text"),

        Skeleton = {},

        Highlight = nil,

        Connections = {}
    }


    for i = 1, 15 do

        esp.Skeleton[i] =
            NewDrawing("Line")

    end


    ESPObjects[player] = esp

end


--==============================================================
-- HIDE ESP
--==============================================================

local function HideESP(esp)

    if not esp then
        return
    end

    esp.Box.Visible = false

    esp.HealthBackground.Visible = false
    esp.HealthBar.Visible = false

    esp.Name.Visible = false
    esp.Distance.Visible = false
    esp.HealthText.Visible = false

    for _, line in pairs(
        esp.Skeleton
    ) do

        line.Visible = false

    end

end


--==============================================================
-- REMOVE ESP
--==============================================================

local function RemoveESP(player)

    local esp =
        ESPObjects[player]

    if not esp then
        return
    end


    for _, connection in pairs(
        esp.Connections
    ) do

        pcall(function()
            connection:Disconnect()
        end)

    end


    for _, object in pairs(esp) do

        if typeof(object) == "userdata" then

            pcall(function()

                object.Visible = false
                object:Remove()

            end)

        elseif type(object) == "table" then

            for _, drawing in pairs(object) do

                pcall(function()

                    drawing.Visible = false
                    drawing:Remove()

                end)

            end
        end
    end


    if esp.Highlight then

        pcall(function()
            esp.Highlight:Destroy()
        end)

    end


    ESPObjects[player] = nil

end


--==============================================================
-- PLAYER SETUP
--==============================================================

local function SetupPlayer(player)

    if player == LocalPlayer then
        return
    end


    CreateESP(player)

    local esp =
        ESPObjects[player]

    if not esp then
        return
    end


    --==========================================================
    -- CHARACTER ADDED
    --==========================================================

    esp.Connections.CharacterAdded =
        player.CharacterAdded:Connect(
            function(character)

                HideESP(esp)


                if esp.Highlight then

                    pcall(function()
                        esp.Highlight:Destroy()
                    end)

                    esp.Highlight = nil

                end


                task.wait(0.15)

                -- ESP object remains alive.
                -- UpdateESP automatically uses the new character.

            end
        )


    --==========================================================
    -- CHARACTER REMOVING
    --==========================================================

    esp.Connections.CharacterRemoving =
        player.CharacterRemoving:Connect(
            function()

                HideESP(esp)


                if esp.Highlight then

                    pcall(function()
                        esp.Highlight:Destroy()
                    end)

                    esp.Highlight = nil

                end

            end
        )

end


for _, player in ipairs(
    Players:GetPlayers()
) do

    SetupPlayer(player)

end


Players.PlayerAdded:Connect(
    function(player)

        SetupPlayer(player)

    end
)


Players.PlayerRemoving:Connect(
    function(player)

        RemoveESP(player)

    end
)


--==============================================================
-- GET BOUNDING BOX
--==============================================================

local function GetBoundingBox(character)

    local minX = math.huge
    local minY = math.huge

    local maxX = -math.huge
    local maxY = -math.huge

    local found = false


    for _, part in ipairs(
        character:GetChildren()
    ) do

        if part:IsA("BasePart") then

            local cf =
                part.CFrame

            local half =
                part.Size / 2


            local corners = {

                cf * Vector3.new(
                    -half.X,
                    -half.Y,
                    -half.Z
                ),

                cf * Vector3.new(
                    -half.X,
                    -half.Y,
                    half.Z
                ),

                cf * Vector3.new(
                    -half.X,
                    half.Y,
                    -half.Z
                ),

                cf * Vector3.new(
                    -half.X,
                    half.Y,
                    half.Z
                ),

                cf * Vector3.new(
                    half.X,
                    -half.Y,
                    -half.Z
                ),

                cf * Vector3.new(
                    half.X,
                    -half.Y,
                    half.Z
                ),

                cf * Vector3.new(
                    half.X,
                    half.Y,
                    -half.Z
                ),

                cf * Vector3.new(
                    half.X,
                    half.Y,
                    half.Z
                )
            }


            for _, position in ipairs(
                corners
            ) do

                local screen, visible =
                    Camera:WorldToViewportPoint(
                        position
                    )


                if visible
                    and screen.Z > 0 then

                    found = true

                    minX =
                        math.min(
                            minX,
                            screen.X
                        )

                    minY =
                        math.min(
                            minY,
                            screen.Y
                        )

                    maxX =
                        math.max(
                            maxX,
                            screen.X
                        )

                    maxY =
                        math.max(
                            maxY,
                            screen.Y
                        )

                end
            end
        end
    end


    if not found then
        return nil
    end


    return {

        X = minX,

        Y = minY,

        Width =
            maxX - minX,

        Height =
            maxY - minY
    }

end


--==============================================================
-- SKELETON
--==============================================================

local SkeletonConnections = {

    {"Head", "UpperTorso"},

    {"UpperTorso", "LowerTorso"},

    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},

    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},

    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},

    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"}
}


local function GetBodyPart(character, name)

    return character:FindFirstChild(
        name
    )

end


--==============================================================
-- HIGHLIGHT
--==============================================================

local function UpdateHighlight(
    player,
    character,
    alive
)

    local esp =
        ESPObjects[player]

    if not esp then
        return
    end


    if not Settings.TargetHighlight
        or not alive then

        if esp.Highlight then

            pcall(function()
                esp.Highlight:Destroy()
            end)

            esp.Highlight = nil

        end

        return
    end


    if not esp.Highlight then

        local highlight =
            Instance.new("Highlight")


        highlight.Name =
            "VoxelCombatHighlight"

        highlight.DepthMode =
            Enum.HighlightDepthMode.AlwaysOnTop

        highlight.FillTransparency =
            0.65

        highlight.OutlineTransparency =
            0

        highlight.Parent =
            character

        esp.Highlight =
            highlight

    end


    esp.Highlight.Adornee =
        character

    esp.Highlight.FillColor =
        Settings.TargetHighlightColor

    esp.Highlight.OutlineColor =
        Settings.TargetHighlightColor

end


--==============================================================
-- UPDATE ESP
--==============================================================

local function UpdateESP(player, esp)

    if not Settings.ESPEnabled then

        HideESP(esp)

        return
    end


    local character =
        player.Character


    if not character then

        HideESP(esp)

        return
    end


    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )


    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )
        or character.PrimaryPart


    if not humanoid
        or not root
        or humanoid.Health <= 0 then

        HideESP(esp)

        UpdateHighlight(
            player,
            character,
            false
        )

        return
    end


    local bounds =
        GetBoundingBox(character)


    if not bounds then

        HideESP(esp)

        return
    end


    local color =
        Settings.ESPColor


    --==========================================================
    -- BOX
    --==========================================================

    if Settings.BoxESP then

        esp.Box.Visible = true

        esp.Box.Position =
            Vector2.new(
                bounds.X,
                bounds.Y
            )

        esp.Box.Size =
            Vector2.new(
                bounds.Width,
                bounds.Height
            )

        esp.Box.Color =
            color

    else

        esp.Box.Visible = false

    end


    --==========================================================
    -- HEALTH BAR
    --==========================================================

    if Settings.HealthBar then

        local health =
            math.clamp(
                humanoid.Health /
                math.max(
                    humanoid.MaxHealth,
                    1
                ),
                0,
                1
            )


        local x =
            bounds.X - 6


        esp.HealthBackground.Visible =
            true

        esp.HealthBackground.Position =
            Vector2.new(
                x,
                bounds.Y
            )

        esp.HealthBackground.Size =
            Vector2.new(
                3,
                bounds.Height
            )

        esp.HealthBackground.Color =
            Color3.fromRGB(
                40,
                40,
                40
            )


        esp.HealthBar.Visible =
            true

        esp.HealthBar.Position =
            Vector2.new(
                x,
                bounds.Y +
                bounds.Height -
                bounds.Height * health
            )

        esp.HealthBar.Size =
            Vector2.new(
                3,
                bounds.Height * health
            )


        esp.HealthBar.Color =
            Color3.fromRGB(
                math.floor(
                    255 * (1 - health)
                ),

                math.floor(
                    255 * health
                ),

                60
            )

    else

        esp.HealthBackground.Visible =
            false

        esp.HealthBar.Visible =
            false

    end


    --==========================================================
    -- NAME
    --==========================================================

    if Settings.NameESP then

        esp.Name.Visible = true

        esp.Name.Text =
            player.DisplayName

        esp.Name.Position =
            Vector2.new(
                bounds.X +
                bounds.Width / 2,

                bounds.Y - 16
            )

        esp.Name.Color =
            color

    else

        esp.Name.Visible = false

    end


    --==========================================================
    -- DISTANCE
    --==========================================================

    if Settings.DistanceESP then

        local myCharacter =
            LocalPlayer.Character


        local myRoot =
            myCharacter
            and (
                myCharacter:FindFirstChild(
                    "HumanoidRootPart"
                )
                or myCharacter.PrimaryPart
            )


        if myRoot then

            local distance =
                (
                    root.Position -
                    myRoot.Position
                ).Magnitude


            esp.Distance.Visible =
                true

            esp.Distance.Text =
                string.format(
                    "[%dm]",
                    math.floor(distance)
                )

            esp.Distance.Position =
                Vector2.new(
                    bounds.X +
                    bounds.Width / 2,

                    bounds.Y +
                    bounds.Height +
                    2
                )

            esp.Distance.Color =
                color

        else

            esp.Distance.Visible =
                false

        end

    else

        esp.Distance.Visible =
            false

    end


    --==========================================================
    -- HEALTH TEXT
    --==========================================================

    if Settings.HealthText then

        esp.HealthText.Visible =
            true

        esp.HealthText.Text =
            string.format(
                "%d/%d",

                math.floor(
                    humanoid.Health
                ),

                math.floor(
                    humanoid.MaxHealth
                )
            )


        esp.HealthText.Position =
            Vector2.new(
                bounds.X +
                bounds.Width +
                22,

                bounds.Y +
                bounds.Height / 2
            )

        esp.HealthText.Color =
            color

    else

        esp.HealthText.Visible =
            false

    end


    --==========================================================
    -- SKELETON
    --==========================================================

    if Settings.SkeletonESP then

        for i, pair in ipairs(
            SkeletonConnections
        ) do

            local partA =
                GetBodyPart(
                    character,
                    pair[1]
                )

            local partB =
                GetBodyPart(
                    character,
                    pair[2]
                )


            local line =
                esp.Skeleton[i]


            if partA and partB then

                local posA, visibleA =
                    Camera:WorldToViewportPoint(
                        partA.Position
                    )


                local posB, visibleB =
                    Camera:WorldToViewportPoint(
                        partB.Position
                    )


                if visibleA
                    and visibleB
                    and posA.Z > 0
                    and posB.Z > 0 then

                    line.Visible = true

                    line.From =
                        Vector2.new(
                            posA.X,
                            posA.Y
                        )

                    line.To =
                        Vector2.new(
                            posB.X,
                            posB.Y
                        )

                    line.Color =
                        color

                else

                    line.Visible = false

                end

            else

                line.Visible = false

            end
        end

    else

        for _, line in pairs(
            esp.Skeleton
        ) do

            line.Visible = false

        end
    end


    --==========================================================
    -- HIGHLIGHT
    --==========================================================

    UpdateHighlight(
        player,
        character,
        true
    )

end


--==============================================================
-- ESP RENDER LOOP
--==============================================================

RunService.RenderStepped:Connect(
    function()

        Camera =
            Workspace.CurrentCamera


        for player, esp in pairs(
            ESPObjects
        ) do

            if player.Parent == Players then

                pcall(function()

                    UpdateESP(
                        player,
                        esp
                    )

                end)

            end
        end
    end
)


