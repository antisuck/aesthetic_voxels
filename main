--==============================================================
-- HEALTH COLOR
--==============================================================

local function getESPHealthColor(percent)

    if percent > 0.60 then

        return Color3.fromRGB(
            60,
            255,
            110
        )

    elseif percent > 0.30 then

        return Color3.fromRGB(
            255,
            220,
            60
        )

    else

        return Color3.fromRGB(
            255,
            60,
            60
        )
    end
end

--==============================================================
-- CHARACTER PARTS
--==============================================================

local function getCharacterParts(character)

    if not character then
        return {}
    end

    local parts = {}

    for _, obj in ipairs(
        character:GetDescendants()
    ) do

        if obj:IsA("BasePart")
            and obj.Transparency < 1 then

            table.insert(
                parts,
                obj
            )
        end
    end

    return parts
end

--==============================================================
-- BOUNDING BOX
--==============================================================

local function getHybridBoundingBox(character)

    if not character then
        return nil
    end

    if not Camera then
        return nil
    end

    local parts =
        getCharacterParts(character)

    if #parts == 0 then
        return nil
    end

    local minX = math.huge
    local minY = math.huge

    local maxX = -math.huge
    local maxY = -math.huge

    local visiblePoints = 0
    local totalPoints = 0

    for _, part in ipairs(parts) do

        local cf =
            part.CFrame

        local half =
            part.Size / 2

        local corners = {

            Vector3.new(
                -half.X,
                -half.Y,
                -half.Z
            ),

            Vector3.new(
                -half.X,
                -half.Y,
                half.Z
            ),

            Vector3.new(
                -half.X,
                half.Y,
                -half.Z
            ),

            Vector3.new(
                -half.X,
                half.Y,
                half.Z
            ),

            Vector3.new(
                half.X,
                -half.Y,
                -half.Z
            ),

            Vector3.new(
                half.X,
                -half.Y,
                half.Z
            ),

            Vector3.new(
                half.X,
                half.Y,
                -half.Z
            ),

            Vector3.new(
                half.X,
                half.Y,
                half.Z
            )
        }

        for _, corner in ipairs(corners) do

            totalPoints += 1

            local worldPosition =
                cf:PointToWorldSpace(
                    corner
                )

            local screenPosition =
                Camera:WorldToViewportPoint(
                    worldPosition
                )

            if screenPosition.Z > 0 then

                visiblePoints += 1

                minX =
                    math.min(
                        minX,
                        screenPosition.X
                    )

                minY =
                    math.min(
                        minY,
                        screenPosition.Y
                    )

                maxX =
                    math.max(
                        maxX,
                        screenPosition.X
                    )

                maxY =
                    math.max(
                        maxY,
                        screenPosition.Y
                    )
            end
        end
    end

    if visiblePoints < 2 then
        return nil
    end

    local width =
        maxX - minX

    local height =
        maxY - minY

    if width < 2
        or height < 2 then

        return nil
    end

    return {

        X = minX,

        Y = minY,

        Width = width,

        Height = height,

        CenterX =
            (minX + maxX) / 2,

        CenterY =
            (minY + maxY) / 2
    }
end

