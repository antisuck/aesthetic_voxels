--==============================================================
-- FLY ENABLE
--==============================================================

local function disableFly()

    safeDestroy(
        State.FlyBodyVelocity
    )

    safeDestroy(
        State.FlyBodyGyro
    )

    State.FlyBodyVelocity =
        nil

    State.FlyBodyGyro =
        nil

    local character =
        LocalPlayer.Character

    local humanoid =
        getHumanoid(character)

    if humanoid then

        pcall(function()
            humanoid.PlatformStand =
                false
        end)
    end

    FlyGui.Enabled =
        false

    for _, data in pairs(
        FlyButtons
    ) do

        data.Held =
            false
    end
end

local function enableFly()

    disableFly()

    local character =
        LocalPlayer.Character

    if not character then
        return false
    end

    local root =
        getRoot(character)

    local humanoid =
        getHumanoid(character)

    if not root or not humanoid then
        return false
    end

    pcall(function()
        humanoid.PlatformStand =
            true
    end)

    local bv =
        Instance.new(
            "BodyVelocity"
        )

    bv.MaxForce =
        Vector3.new(
            1e9,
            1e9,
            1e9
        )

    bv.Velocity =
        Vector3.zero

    bv.Parent =
        root

    local bg =
        Instance.new(
            "BodyGyro"
        )

    bg.MaxTorque =
        Vector3.new(
            1e9,
            1e9,
            1e9
        )

    bg.P =
        10000

    bg.CFrame =
        root.CFrame

    bg.Parent =
        root

    State.FlyBodyVelocity =
        bv

    State.FlyBodyGyro =
        bg

    FlyGui.Enabled =
        UserInputService.TouchEnabled

    return true
end

--==============================================================
-- FLY MOVEMENT
--==============================================================

RunService.RenderStepped:Connect(function()

    if not State.FlyEnabled then
        return
    end

    local bv =
        State.FlyBodyVelocity

    local bg =
        State.FlyBodyGyro

    if not bv or not bg then
        return
    end

    if not Camera then
        return
    end

    local direction =
        Vector3.zero

    -- Keyboard

    if UserInputService:IsKeyDown(
        Enum.KeyCode.W
    ) then

        direction +=
            Camera.CFrame.LookVector
    end

    if UserInputService:IsKeyDown(
        Enum.KeyCode.S
    ) then

        direction -=
            Camera.CFrame.LookVector
    end

    if UserInputService:IsKeyDown(
        Enum.KeyCode.A
    ) then

        direction -=
            Camera.CFrame.RightVector
    end

    if UserInputService:IsKeyDown(
        Enum.KeyCode.D
    ) then

        direction +=
            Camera.CFrame.RightVector
    end

    if UserInputService:IsKeyDown(
        Enum.KeyCode.Space
    ) then

        direction +=
            Vector3.new(
                0,
                1,
                0
            )
    end

    if UserInputService:IsKeyDown(
        Enum.KeyCode.LeftControl
    ) then

        direction -=
            Vector3.new(
                0,
                1,
                0
            )
    end

    -- Mobile

    if FlyButtons.Forward.Held then
        direction +=
            Camera.CFrame.LookVector
    end

    if FlyButtons.Back.Held then
        direction -=
            Camera.CFrame.LookVector
    end

    if FlyButtons.Left.Held then
        direction -=
            Camera.CFrame.RightVector
    end

    if FlyButtons.Right.Held then
        direction +=
            Camera.CFrame.RightVector
    end

    if FlyButtons.Up.Held then
        direction +=
            Vector3.new(
                0,
                1,
                0
            )
    end

    if FlyButtons.Down.Held then
        direction -=
            Vector3.new(
                0,
                1,
                0
            )
    end

    if direction.Magnitude > 0 then

        bv.Velocity =
            direction.Unit
            * State.FlySpeed

    else

        bv.Velocity =
            Vector3.zero
    end

    bg.CFrame =
        CFrame.lookAt(
            rootPositionOrFallback(
                LocalPlayer.Character
            ),
            rootPositionOrFallback(
                LocalPlayer.Character
            ) + Camera.CFrame.LookVector
        )
end)

--==============================================================
-- ROOT POSITION HELPER
--==============================================================

function rootPositionOrFallback(character)

    local root =
        getRoot(character)

    if root then
        return root.Position
    end

    return Vector3.zero
end

