--==============================================================
-- KILL AURA
--==============================================================

local function performAttack()

    if not AttackRemote then
        return false
    end

    local target =
        getNearestTarget()

    if not target then
        return false
    end

    local character =
        LocalPlayer.Character

    if not character then
        return false
    end

    local slot =
        character:GetAttribute(
            "ReplicatedHotbarSlot"
        )

    if slot == nil then
        return false
    end

    local success =
        pcall(function()

            AttackRemote:InvokeServer(
                target,
                tostring(slot)
            )

        end)

    return success
end

task.spawn(function()

    while true do

        local shouldAttack =
            State.KillAura

        --==========================================================
        -- JUMP ATTACK
        --==========================================================

        if State.JumpAttack then

            if isLocalPlayerJumping() then

                shouldAttack =
                    State.KillAura
            end
        end

        if shouldAttack then

            performAttack()

            task.wait(
                math.max(
                    State.AttackDelay,
                    0.01
                )
            )

        else

            task.wait(0.05)

        end
    end
end)
--==============================================================
-- JUMP STATE
--==============================================================

local function isLocalPlayerJumping()

    local character =
        LocalPlayer.Character

    local humanoid =
        getHumanoid(character)

    if not humanoid then
        return false
    end

    local state =
        humanoid:GetState()

    return state ==
        Enum.HumanoidStateType.Jumping
        or state ==
        Enum.HumanoidStateType.Freefall
end

--==============================================================
-- NO FALL / NO DROWN
--==============================================================

if typeof(hookmetamethod) ==
    "function"
    and typeof(getnamecallmethod) ==
    "function" then

    local oldNamecall

    oldNamecall =
        hookmetamethod(
            game,
            "__namecall",
            function(self, ...)

                local method

                pcall(function()
                    method =
                        getnamecallmethod()
                end)

                if method == "FireServer"
                    and self == FallRemote
                    and (
                        State.NoFallDamage
                        or State.NoDrowDamage
                    ) then

                    return nil
                end

                return oldNamecall(
                    self,
                    ...
                )
            end
        )

    State.OldNamecall =
        oldNamecall
end

