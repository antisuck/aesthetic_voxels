    task.wait(1)

    applyCharacterStats()

    if State.FlyEnabled then
        enableFly()
    end

end)
--==============================================================
-- CROSSHAIR SYSTEM
--==============================================================

local CrosshairState = {
    Enabled    = true,
    Size       = 32,
    ImageID    = "",
    CursorName = "",
    SavedCursors = {},
}

local CURSOR_FOLDER = "aesthetic"
local CURSOR_FILE   = "aesthetic/cursors.json"

local function hasFS()
    return type(isfile) == "function"
        and type(readfile) == "function"
        and type(writefile) == "function"
        and type(isfolder) == "function"
        and type(makefolder) == "function"
end

local function loadCursors()
    CrosshairState.SavedCursors = {}
    if not hasFS() then return end
    pcall(function()
        if not isfolder(CURSOR_FOLDER) then makefolder(CURSOR_FOLDER) end
        if not isfile(CURSOR_FILE) then
            writefile(CURSOR_FILE, "{}")
            return
        end
        local raw = readfile(CURSOR_FILE)
        if raw == "" then return end
        local data = HttpService:JSONDecode(raw)
        if type(data) == "table" then
            CrosshairState.SavedCursors = data
        end
    end)
end

local function saveCursors()
    if not hasFS() then return false end
    return pcall(function()
        if not isfolder(CURSOR_FOLDER) then makefolder(CURSOR_FOLDER) end
        writefile(CURSOR_FILE, HttpService:JSONEncode(CrosshairState.SavedCursors))
    end)
end

loadCursors()

local function getImageObj()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local camGui = pg:FindFirstChild("CameraGui")
    if not camGui then return nil end
    local crosshair = camGui:FindFirstChild("Crosshair")
    if not crosshair then return nil end

    if crosshair:IsA("ImageLabel") or crosshair:IsA("ImageButton") then
        return crosshair
    end
    return crosshair:FindFirstChildWhichIsA("ImageLabel", true)
        or crosshair:FindFirstChildWhichIsA("ImageButton", true)
end

local function applyCrosshairImage(id)
    local obj = getImageObj()
    if not obj then return false end
    id = tostring(id or ""):match("^%s*(.-)%s*$")
    if id == "" then return false end
    obj.Image = id:match("^rbxassetid://") and id or ("rbxassetid://" .. id)
    return true
end

local function applyCrosshairSize(sz)
    local obj = getImageObj()
    if not obj then return end
    CrosshairState.Size = sz
    local camGui   = LocalPlayer.PlayerGui:FindFirstChild("CameraGui")
    local crosshair = camGui and camGui:FindFirstChild("Crosshair")
    local scale = crosshair and crosshair:FindFirstChildWhichIsA("UIScale", true)
    if scale then
        scale.Scale = sz / 32
    else
        obj.Size = UDim2.fromOffset(sz, sz)
    end
end

local function applyCrosshairVisible(v)
    local obj = getImageObj()
    CrosshairState.Enabled = v
    if obj then obj.Visible = v end
end

local function getCursorNames()
    local names = {}
    for name, data in pairs(CrosshairState.SavedCursors) do
        if type(data) == "table" and data.id then
            table.insert(names, name)
        end
    end
    table.sort(names)
    return names
end

--==============================================================
-- CONFIG SYSTEM
--==============================================================

local CONFIG_FOLDER = "aesthetic"
local SelectedConfig = nil

local function getConfigNames()
    local names = {}
    if not hasFS() then return names end
    pcall(function()
        if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
        -- list all .json except cursors.json
        -- Rayfield handles its own config; we do manual slot configs
        if isfolder(CONFIG_FOLDER) then
            -- we use a manifest
            local manifestPath = CONFIG_FOLDER .. "/manifest.json"
            if isfile(manifestPath) then
                local data = HttpService:JSONDecode(readfile(manifestPath))
                if type(data) == "table" then
                    names = data
                end
            end
        end
    end)
    return names
end

local function saveManifest(list)
    if not hasFS() then return end
    pcall(function()
        if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
        writefile(CONFIG_FOLDER .. "/manifest.json", HttpService:JSONEncode(list))
    end)
end

local function buildStateSnapshot()
    return {
        ESPEnabled    = State.ESPEnabled,
        ESPColor      = { State.ESPColor.R, State.ESPColor.G, State.ESPColor.B },
        FOVEnabled    = State.FOVEnabled,
        FOVSize       = State.FOVSize,
        FOVRainbow    = State.FOVRainbow,
        KillAura      = State.KillAura,
        KillAuraRange = State.KillAuraRange,
        AttackDelay   = State.AttackDelay,
        AimbotEnabled = State.AimbotEnabled,
        NoFallDamage  = State.NoFallDamage,
        NoDrowDamage  = State.NoDrowDamage,
        Speed         = State.Speed,
        JumpPower     = State.JumpPower,
    }
end

local function applySnapshot(snap)
    if not snap then return end
    State.ESPEnabled    = snap.ESPEnabled    or false
    State.FOVEnabled    = snap.FOVEnabled    or false
    State.FOVSize       = snap.FOVSize       or 120
    State.FOVRainbow    = snap.FOVRainbow    or false
    State.KillAura      = snap.KillAura      or false
    State.KillAuraRange = snap.KillAuraRange or 24
    State.AttackDelay   = snap.AttackDelay   or 0.35
    State.AimbotEnabled = snap.AimbotEnabled or false
    State.NoFallDamage  = snap.NoFallDamage  or false
    State.NoDrowDamage  = snap.NoDrowDamage  or false
    State.Speed         = snap.Speed         or 16
    State.JumpPower     = snap.JumpPower     or 50
    if snap.ESPColor then
        State.ESPColor = Color3.new(
            snap.ESPColor[1],
            snap.ESPColor[2],
            snap.ESPColor[3]
        )
    end
    applyCharacterStats()
end

