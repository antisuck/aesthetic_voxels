ConfigTab:CreateSection(
    "Config Manager"
)


local ConfigName =
    Settings.CurrentConfig


ConfigTab:CreateInput({

    Name = "Config Name",

    PlaceholderText =
        "Enter config name",

    RemoveTextAfterFocusLost =
        false,

    Callback = function(text)

        if text
            and text ~= "" then

            ConfigName =
                text

            Settings.CurrentConfig =
                text

        end

    end
})


ConfigTab:CreateButton({

    Name = "Create Config",

    Callback = function()

        if SaveConfig(ConfigName) then

            Rayfield:Notify({

                Title = "Config",

                Content =
                    "Created: " ..
                    ConfigName,

                Duration = 3

            })

        else

            Rayfield:Notify({

                Title = "Config",

                Content =
                    "Could not create config",

                Duration = 3

            })

        end

    end
})


ConfigTab:CreateButton({

    Name = "Load Config",

    Callback = function()

        if LoadConfig(ConfigName) then

            KillAuraEnabled =
                Settings.KillAura

            ApplyMovement()


            if Settings.Fly then

                FlyGui.Enabled =
                    true

                StartFly()

            else

                FlyGui.Enabled =
                    false

                StopFly()

            end


            Rayfield:Notify({

                Title = "Config",

                Content =
                    "Loaded: " ..
                    ConfigName,

                Duration = 3

            })

        else

            Rayfield:Notify({

                Title = "Config",

                Content =
                    "Config not found",

                Duration = 3

            })

        end

    end
})


ConfigTab:CreateButton({

    Name = "Save Config",

    Callback = function()

        if SaveConfig(ConfigName) then

            Rayfield:Notify({

                Title = "Config",

                Content =
                    "Saved: " ..
                    ConfigName,

                Duration = 3

            })

        end

    end
})


ConfigTab:CreateButton({

    Name = "Delete Config",

    Callback = function()

        if DeleteConfig(ConfigName) then

            Rayfield:Notify({

                Title = "Config",

                Content =
                    "Deleted: " ..
                    ConfigName,

                Duration = 3

            })

        end

    end
})


ConfigTab:CreateButton({

    Name = "Rename Config",

    Callback = function()

        if not ConfigExists(
            ConfigName
        ) then

            return

        end


        local newName =
            ConfigName .. "_renamed"


        if SaveConfig(newName) then

            DeleteConfig(
                ConfigName
            )


            ConfigName =
                newName

            Settings.CurrentConfig =
                newName


            Rayfield:Notify({

                Title = "Config",

                Content =
                    "Renamed to " ..
                    newName,

                Duration = 3

            })

        end

    end
})


ConfigTab:CreateButton({

    Name = "Reset Config",

    Callback = function()

        Settings.ESPEnabled = true

        Settings.BoxESP = true
        Settings.SkeletonESP = false
        Settings.HealthBar = true
        Settings.HealthText = true
        Settings.NameESP = true
        Settings.DistanceESP = true

        Settings.ESPColor =
            Color3.fromRGB(
                255,
                255,
                255
            )

        Settings.TargetHighlight =
            true

        Settings.TargetHighlightColor =
            Color3.fromRGB(
                255,
                80,
                80
            )

        Settings.KillAura = false
        Settings.KillAuraRange = 24

        Settings.ShowFOV = true
        Settings.FOVRadius = 100

        Settings.FOVColor =
            Color3.fromRGB(
                255,
                80,
                80
            )

        Settings.KillAuraDelay =
            0.35

        Settings.Fly = false
        Settings.FlySpeed = 50

        Settings.Speed = 16
        Settings.JumpPower = 50

        Settings.Noclip = false

        KillAuraEnabled = false

        FlyGui.Enabled = false

        StopFly()

        ApplyMovement()


        Rayfield:Notify({

            Title = "Config",

            Content =
                "Settings reset",

            Duration = 3

        })

    end
})


ConfigTab:CreateButton({

    Name = "Import Config",

    Callback = function()

        if not getclipboard then

            Rayfield:Notify({

                Title = "Import",

                Content =
                    "Clipboard API unavailable",

                Duration = 3

            })

            return
        end


        local success =
            pcall(function()

                local text =
                    getclipboard()


                local data =
                    HttpService:JSONDecode(
                        text
                    )


                ApplySettings(data)

                KillAuraEnabled =
                    Settings.KillAura

                ApplyMovement()


                if Settings.Fly then

                    FlyGui.Enabled =
                        true

                    StartFly()

                end

            end)


        if success then

            Rayfield:Notify({

                Title = "Import",

                Content =
                    "Config imported",

                Duration = 3

            })

        else

            Rayfield:Notify({

                Title = "Import",

                Content =
                    "Invalid config",

                Duration = 3

            })

        end

    end
})


ConfigTab:CreateButton({

    Name = "Export Config",

    Callback = function()

        if not setclipboard then

            Rayfield:Notify({

                Title = "Export",

                Content =
                    "Clipboard API unavailable",

                Duration = 3

            })

            return
        end


        local success =
            pcall(function()

                local data =
                    HttpService:JSONEncode(
                        SerializeSettings()
                    )


                setclipboard(data)

            end)


        if success then

            Rayfield:Notify({

                Title = "Export",

                Content =
                    "Config copied",

                Duration = 3

            })

        end

    end
})


ConfigTab:CreateToggle({

    Name = "Auto Load Config",

    CurrentValue =
        Settings.AutoLoadConfig,

    Callback = function(value)

        Settings.AutoLoadConfig =
            value

    end
})


--==============================================================
-- AUTO LOAD
--==============================================================

task.spawn(
    function()

        task.wait(1)


        if Settings.AutoLoadConfig then

            if LoadConfig(
                Settings.CurrentConfig
            ) then

                KillAuraEnabled =
                    Settings.KillAura

                ApplyMovement()


                if Settings.Fly then

                    FlyGui.Enabled =
                        true

                    StartFly()

                end

            end
        end
    end
)


