--==============================================================
-- AIMBOT
--==============================================================

--==============================================================
-- UNIVERSAL AIM PART
--==============================================================

local function getAimPart(character)

    if not character then
        return nil
    end

    -- 1. Head
    local head =
        character:FindFirstChild("Head")

    if head
        and head:IsA("BasePart") then

        return head
    end

    -- 2. PrimaryPart
    if character.PrimaryPart
        and character.PrimaryPart:IsA("BasePart") then

        return character.PrimaryPart
    end

    -- 3. HumanoidRootPart
    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if root
        and root:IsA("BasePart") then

        return root
    end

    -- 4. Любая подходящая часть
    for _, obj in ipairs(
        character:GetDescendants()
    ) do

        if obj:IsA("BasePart")
            and obj.Transparency < 1 then

            return obj
        end
    end

    return nil
end

--==============================================================
-- AIMBOT TARGET
--==============================================================

local function getAimbotTarget()

    local center =
        Vector2.new(
            Camera.ViewportSize.X / 2,
            Camera.ViewportSize.Y / 2
        )

    local nearestPart = nil

    local nearestDistance =
        State.FOVSize

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player == LocalPlayer then
            continue
        end

        local character =
            player.Character

        if not character then
            continue
        end

        -- Humanoid необязателен
        -- для твоей нестандартной игры
        local humanoid =
            character:FindFirstChildOfClass(
                "Humanoid"
            )

        if humanoid
            and humanoid.Health <= 0 then

            continue
        end

        local aimPart =
            getAimPart(character)

        if not aimPart then
            continue
        end

        local screenPosition,
              onScreen =
            Camera:WorldToViewportPoint(
                aimPart.Position
            )

        if not onScreen then
            continue
        end

        if screenPosition.Z <= 0 then
            continue
        end

        local screenDistance =
            (
                Vector2.new(
                    screenPosition.X,
                    screenPosition.Y
                )
                - center
            ).Magnitude

        if screenDistance <
            nearestDistance then

            nearestDistance =
                screenDistance

            nearestPart =
                aimPart
        end
    end

    return nearestPart
end

--==============================================================
-- AIMBOT
--==============================================================

RunService.RenderStepped:Connect(function()

    if not State.AimbotEnabled then
        return
    end

    local target =
        getAimbotTarget()

    if not target then
        return
    end

    if not target.Parent then
        return
    end

    Camera.CFrame =
        CFrame.new(
            Camera.CFrame.Position,
            target.Position
        )
end)
--==============================================================
-- KILL AURA LOOP
--==============================================================

task.spawn(function()
    while true do
        if State.KillAura then
            local target = getNearestTarget()
            if target then
                local char = LocalPlayer.Character
                if char then
                    local slot = char:GetAttribute("ReplicatedHotbarSlot")
                    if slot ~= nil then
                        pcall(function()
                            AttackRemote:InvokeServer(target, tostring(slot))
                        end)
                    end
                end
            end
        end
        task.wait(State.AttackDelay)
    end
end)

--==============================================================
-- NO FALL DAMAGE / NO DROW DAMAGE (namecall hook)
--==============================================================

if typeof(hookmetamethod) == "function" then
    State.OldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()

        if method == "FireServer" then
            if self == FallRemote and (State.NoFallDamage or State.NoDrowDamage) then
                return
            end
        end

        return State.OldNamecall(self, ...)
    end)
end

