--==============================================================
-- HIDE ESP
--==============================================================

local function hideESP(esp)

    if not esp then
        return
    end

    if esp.Gui then
        esp.Gui.Enabled = false
    end

    esp.Mode = "None"
end

--==============================================================
-- REMOVE ESP
--==============================================================

local function removeESP(player)

    local esp =
        ESPObjects[player]

    if not esp then
        return
    end

    if esp.Tween then
        pcall(function()
            esp.Tween:Cancel()
        end)
    end

    if esp.Part then
        esp.Part:Destroy()
    end

    ESPObjects[player] = nil
end

--==============================================================
-- INITIAL PLAYERS
--==============================================================

for _, player in ipairs(
    Players:GetPlayers()
) do

    createESP(player)

end

--==============================================================
-- PLAYER ADDED
--==============================================================

Players.PlayerAdded:Connect(function(player)

    createESP(player)

end)

--==============================================================
-- PLAYER REMOVING
--==============================================================

Players.PlayerRemoving:Connect(function(player)

    removeESP(player)

end)

--==============================================================
-- CHARACTER ADDED
--==============================================================

local function setupESPCharacter(player)

    player.CharacterAdded:Connect(function()

        local esp =
            ESPObjects[player]

        if esp then

            esp.LastPos = nil

            esp.LastValidTime =
                os.clock()

            esp.Mode = "None"

        end

    end)
end

for _, player in ipairs(
    Players:GetPlayers()
) do

    if player ~= LocalPlayer then
        setupESPCharacter(player)
    end

end

Players.PlayerAdded:Connect(function(player)

    if player ~= LocalPlayer then
        setupESPCharacter(player)
    end

end)

--==============================================================
-- UPDATE LAST POSITION
--==============================================================

local function updateLastPosition(
    player,
    esp,
    distance
)

    local pos =
        player:GetAttribute(
            "LastPosition"
        )

    if typeof(pos) ~= "Vector3" then
        return false
    end

    -- сохраняем последнюю валидную позицию
    esp.LastPos = pos

    --==========================================================
    -- UPDATE BILLBOARD POSITION
    --==========================================================

    if esp.Mode ~= "LastPosition" then

        esp.Part.Position = pos

        esp.Mode = "LastPosition"

    else

        local current =
            esp.Part.Position

        local newPosition =
            current:Lerp(
                pos,
                ESPSettings.Smoothness
            )

        esp.Part.Position =
            newPosition
    end

    --==========================================================
    -- SHOW
    --==========================================================

    esp.Gui.Enabled = true

    --==========================================================
    -- LAST POSITION STYLE
    --==========================================================

    esp.BoxStroke.Color =
        State.ESPColor

    esp.NameText.Text =
        player.DisplayName

    esp.HealthBackground.Visible =
        false

    esp.HealthBar.Visible =
        false

    esp.HealthText.Visible =
        false

    esp.DistanceText.Visible =
        true

    esp.DistanceText.Text =
        math.floor(distance)
        .. " Stud"

    return true
end

--==============================================================
-- MAIN HYBRID ESP LOOP
--==============================================================

RunService.RenderStepped:Connect(function()

    --==========================================================
    -- DISABLED
    --==========================================================

    if not State.ESPEnabled then

        for _, esp in pairs(
            ESPObjects
        ) do

            hideESP(esp)

        end

        return
    end

    --==========================================================
    -- PLAYERS
    --==========================================================

    for player, esp in pairs(
        ESPObjects
    ) do

        if player.Parent ~= Players then

            removeESP(player)

            continue
        end

        --======================================================
        -- CHARACTER
        --======================================================

        local character =
            player.Character

        local humanoid =
            character
            and character:FindFirstChildOfClass(
                "Humanoid"
            )

        --======================================================
        -- LOCAL PLAYER POSITION
        --======================================================

        local localCharacter =
            LocalPlayer.Character

        local localRoot =
            localCharacter
            and localCharacter:FindFirstChild(
                "HumanoidRootPart"
            )

        if not localRoot then

            hideESP(esp)

            continue
        end

        --======================================================
        -- TRY HYBRID FIRST
        --======================================================

        local hybridBox = nil

        if character then

            hybridBox =
                getHybridBoundingBox(
                    character
                )
        end

        --======================================================
        -- HYBRID SUCCESS
        --======================================================

        if hybridBox then

            esp.Mode = "Hybrid"

            esp.Gui.Enabled = false

            --==================================================
            -- REAL CHARACTER BOX
            --==================================================

            -- Billboard отключён.
            -- Для Hybrid используем ScreenGui.
            -- Создаём его лениво.

            if not esp.ScreenGui then

                local screenGui =
                    Instance.new(
                        "ScreenGui"
                    )

                screenGui.Name =
                    "HybridESP"

                screenGui.IgnoreGuiInset =
                    true

                screenGui.ResetOnSpawn =
                    false

                screenGui.Parent =
                    LocalPlayer.PlayerGui

                local frame =
                    Instance.new(
                        "Frame"
                    )

                frame.Name = "Box"

                frame.BackgroundTransparency =
                    1

                frame.BorderSizePixel = 0

                frame.Parent =
                    screenGui

                local stroke =
                    Instance.new(
                        "UIStroke"
                    )

                stroke.Thickness =
                    ESPSettings.BoxThickness

                stroke.Color =
                    State.ESPColor

                stroke.Parent = frame

                -- NAME

                local name =
                    Instance.new(
                        "TextLabel"
                    )

                name.Name = "Name"

                name.AnchorPoint =
                    Vector2.new(
                        0.5,
                        1
                    )

                name.BackgroundTransparency =
                    1

                name.TextColor3 =
                    ESPSettings.TextColor

                name.TextStrokeColor3 =
                    Color3.new(
                        0,
                        0,
                        0
                    )

                name.TextStrokeTransparency =
                    0

                name.Font =
                    Enum.Font.GothamBold

                name.TextSize = 13

                name.Parent =
                    screenGui

                -- HP

                local hp =
                    Instance.new(
                        "TextLabel"
                    )

                hp.Name =
                    "Health"

                hp.AnchorPoint =
                    Vector2.new(
                        0,
                        0.5
                    )

                hp.BackgroundTransparency =
                    1

                hp.TextStrokeColor3 =
                    Color3.new(
                        0,
                        0,
                        0
                    )

                hp.TextStrokeTransparency =
                    0

                hp.Font =
                    Enum.Font.GothamBold

                hp.TextSize = 11

                hp.TextXAlignment =
                    Enum.TextXAlignment.Left

                hp.Parent =
                    screenGui

                -- DISTANCE

                local distance =
                    Instance.new(
                        "TextLabel"
                    )

                distance.Name =
                    "Distance"

                distance.AnchorPoint =
                    Vector2.new(
                        0.5,
                        0
                    )

                distance.BackgroundTransparency =
                    1

                distance.TextColor3 =
                    Color3.fromRGB(
                        200,
                        200,
                        200
                    )

                distance.TextStrokeColor3 =
                    Color3.new(
                        0,
                        0,
                        0
                    )

                distance.TextStrokeTransparency =
                    0

                distance.Font =
                    Enum.Font.Gotham

                distance.TextSize = 11

                distance.Parent =
                    screenGui

                esp.ScreenGui =
                    screenGui

                esp.ScreenBox =
                    frame

                esp.ScreenStroke =
                    stroke

                esp.ScreenName =
                    name

                esp.ScreenHealth =
                    hp

                esp.ScreenDistance =
                    distance
            end

            --==================================================
            -- ENABLE SCREEN ESP
            --==================================================

            esp.ScreenGui.Enabled = true

            local box =
                esp.ScreenBox

            local stroke =
                esp.ScreenStroke

            local name =
                esp.ScreenName

            local hp =
                esp.ScreenHealth

            local distanceLabel =
                esp.ScreenDistance

            --==================================================
            -- BOX
            --==================================================

            box.Position =
                UDim2.fromOffset(
                    hybridBox.X,
                    hybridBox.Y
                )

            box.Size =
                UDim2.fromOffset(
                    hybridBox.Width,
                    hybridBox.Height
                )

            stroke.Color =
                State.ESPColor

            --==================================================
            -- NAME
            --==================================================

            name.Position =
                UDim2.fromOffset(
                    hybridBox.CenterX,
                    hybridBox.Y - 4
                )

            name.Size =
                UDim2.fromOffset(
                    200,
                    18
                )

            name.Text =
                player.DisplayName

            --==================================================
            -- HEALTH
            --==================================================

            local healthColor =
                Color3.fromRGB(
                    180,
                    180,
                    180
                )

            if humanoid
                and humanoid.MaxHealth > 0 then

                local health =
                    math.clamp(
                        humanoid.Health,
                        0,
                        humanoid.MaxHealth
                    )

                local maxHealth =
                    math.max(
                        humanoid.MaxHealth,
                        1
                    )

                local percent =
                    math.clamp(
                        health / maxHealth,
                        0,
                        1
                    )

                healthColor =
                    getESPHealthColor(
                        percent
                    )

                hp.Text =
                    string.format(
                        "%d / %d HP",
                        math.floor(health),
                        math.floor(maxHealth)
                    )

            else

                hp.Text =
                    "? HP"
            end

            hp.TextColor3 =
                healthColor

            hp.Position =
                UDim2.fromOffset(
                    hybridBox.X
                    + hybridBox.Width
                    + 6,

                    hybridBox.CenterY
                )

            hp.Size =
                UDim2.fromOffset(
                    80,
                    18
                )

            --==================================================
            -- DISTANCE
            --==================================================

            local worldPosition

            local primary =
                character.PrimaryPart

            if primary then
                worldPosition =
                    primary.Position
            else
                worldPosition =
                    character:GetPivot().Position
            end

            local distance =
                (
                    localRoot.Position
                    - worldPosition
                ).Magnitude

            distanceLabel.Position =
                UDim2.fromOffset(
                    hybridBox.CenterX,
                    hybridBox.Y
                    + hybridBox.Height
                    + 4
                )

            distanceLabel.Size =
                UDim2.fromOffset(
                    100,
                    18
                )

            distanceLabel.Text =
                math.floor(distance)
                .. " Stud"

            --==================================================
            -- SAVE LAST POSITION
            --==================================================

            local lastPosition =
                character:GetPivot().Position

            player:SetAttribute(
                "LastPosition",
                lastPosition
            )

            esp.LastValidTime =
                os.clock()

            continue
        end

        --======================================================
        -- HYBRID FAILED
        --======================================================

        if esp.ScreenGui then
            esp.ScreenGui.Enabled = false
        end

        --======================================================
        -- LAST POSITION FALLBACK
        --======================================================

        local lastPosition =
            player:GetAttribute(
                "LastPosition"
            )

        if typeof(lastPosition) ==
            "Vector3" then

            local distance =
                (
                    localRoot.Position
                    - lastPosition
                ).Magnitude

            if distance <=
                ESPSettings.MaxDistance then

                updateLastPosition(
                    player,
                    esp,
                    distance
                )

                continue
            end
        end

        --======================================================
        -- NOTHING AVAILABLE
        --======================================================

        hideESP(esp)

    end
end)

--==============================================================
-- CLEANUP
--==============================================================

Players.PlayerRemoving:Connect(function(player)

    local esp =
        ESPObjects[player]

    if esp then

        if esp.ScreenGui then
            esp.ScreenGui:Destroy()
        end

        if esp.Part then
            esp.Part:Destroy()
        end

        ESPObjects[player] = nil
    end
end)

print(
    "[aesthetic] Hybrid ESP loaded"
)
